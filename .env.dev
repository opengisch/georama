#########
# Georama configuration
#########
GEORAMA_DB_NAME=postgres
GEORAMA_DB_USER=postgres
GEORAMA_DB_PW=test
GEORAMA_DB_HOST=georama-db
GEORAMA_DB_PORT=5432
GEORAMA_DB_OPTIONS={}
DJANGO_CONFIGURATION=Dev

#########
# QGIS-Server-Light configuration
#########
QSL_LOG_LEVEL=debug

#########
# Settings for compose build time
#########
# the follwing are only neccessary when you are on a linux OS
UID=<your-host-system-user-id-here>
GID=<your-host-system-users-group-id-here>
# this is optional! used to derive the qsl sources from github
# when building the image (default: master)
QSL_SOURCE_BRANCH=<branch-you-want-to-use>

#########
# Settings for compose overrides
#########
# this is optional! used when you want to develop QGIS-Server-Light
# in parallel with Georama (you need to have the compose override in place!
# this path might be absolute or relative (so ../qgis-server-light) is allowed.
QSL_SOURCE_ROOT=<absolute-or-relative-path-to-your-local-QSL-repo>
