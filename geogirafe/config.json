{
  "general": {
    "locale": "de-CH"
  },
  "languages": {
    "translations": {
      "de": ["i18n/de.json", "http://localhost:4242/webgis/translations/de.json"]
    },
    "defaultLanguage": "de"
  },
  "interface": {
    "defaultSelectionComponent": "grid"
  },
  "themes": {
    "url": "http://localhost:4242/webgis/themes.json",
    "defaultTheme": "forest_fires",
    "selectionMode": "add"
  },
  "basemaps": {
    "defaultBasemap": "OpenStreetMap",
    "OSM": true,
    "SwissTopoVectorTiles": false
  },
  "treeview": {
    "hideLegendWhenLayerIsDeactivated": false,
    "defaultIconSize": {
      "width": "21",
      "height": "16"
    }
  },
  "search": {
    "url": "https://map.geo.bs.ch/search?limit=90&partitionlimit=15&interface=desktop&query=###SEARCHTERM###&lang=###SEARCHLANG###",
    "objectPreview": true,
    "layerPreview": true
  },
  "print": {
    "url": "https://map.geo.bs.ch/printproxy/",
    "defaultLayout": "print_A4_hochformat"
  },
  "share": {
    "service": "lstu",
    "createUrl": "https://map.geo.test.bs.ch/short/create",
    "getUrl": "https://map.geo.test.bs.ch/short/get"
  },
  "projections": {
    "EPSG:3857": "W-M",
    "EPSG:4326": "WGS84",
    "EPSG:2056": "LV95"
  },
  "map": {
    "srid": "EPSG:2056",
    "startZoom": "5",
    "startPosition": "2728253.1,1404432.8",
    "maxExtent": "2420000,1030000,3000000,1500000",
    "scales": [1000000, 400000, 200000, 80000, 40000, 20000, 10000, 8000, 6000, 4000, 2000, 1000, 500, 250, 100, 50]
  },
  "map3d": {
    "terrainUrl": "https://terrain100.geo.admin.ch/1.0.0/ch.swisstopo.terrain.3d/",
    "terrainImagery": {
      "url": "https://wmts20.geo.admin.ch/1.0.0/ch.swisstopo.swissimage-product/default/current/4326/{z}/{x}/{y}.jpeg",
      "minLoD": 8,
      "maxLoD": 17,
      "coverageArea": [5.013926957923385, 45.35600133779394, 11.477436312994008, 48.27502358353741]
    },
    "tilesetsUrls": ["https://vectortiles100.geo.admin.ch/3d-tiles/ch.swisstopo.swisstlm3d.3d/20201020/tileset.json"],
    "maximumZoomDistance": 25000
  },
  "oauth": {
    "issuer": {
      "url": "http://localhost:7080/realms/ninjas",
      "clientId": "georama-oidc",
      "audience": ["localhost"],
      "audienceExcludedPaths": ["^/static/", "^/tiles/"],
      "scope": "openid profile email",
      "checkSessionOnLoad": true,
      "loginRequired": false,
      "allowInsecureRequests": true
    },
    "geomapfish": {
      "userInfoUrl": "http://localhost:7080/realms/ninjas/protocol/openid-connect/userinfo",
      "authMode": "token"
    }
  },
  "contextmenu": {
    "crs": [
      { "code": "EPSG:2056", "translation": "EPSG:2056", "format": "decimal", "precision": 1 },
      { "code": "EPSG:4326", "translation": "EPSG:4326", "format": "decimal", "precision": 7 },
      { "code": "EPSG:4326", "translation": "EPSG:4326-DMS", "format": "dms", "precision": 2 }
    ]
  },
  "crs": [
    {
      "code": "EPSG:2056",
      "definition": "+proj=somerc +lat_0=46.9524055555556 +lon_0=7.43958333333333 +k_0=1 +x_0=2600000 +y_0=1200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs +type=crs"
    }
  ],
  "contact": {
    "url": "https://map.geo.test.bs.ch/feedback",
    "reasons": ["Give feeback", "Ask a question", "Report an error", "Request secure access"],
    "email": "geo@bs.ch"
  },
  "external_layers": {
    "enabled_types": ["WMS", "WMTS", "predefined"],
    "default_type": "predefined",
    "predefined_sources": [
      {
        "label": "WMS Bundes Geodaten-Infrastruktur (BGDI)",
        "type": "WMS",
        "url": "https://wms.geo.admin.ch"
      },
      {
        "label": "WMTS Bundes Geodaten-Infrastruktur (BGDI)",
        "type": "WMTS",
        "url": "https://wmts.geo.admin.ch/1.0.0/WMTSCapabilities.xml?lang=de"
      },
      {
        "label": "WMTS Kanton Basel-Landschaft",
        "type": "WMTS",
        "url": "https://tile.geoview.bl.ch/1.0.0/WMTSCapabilities.xml"
      },
      {
        "label": "WMS GeoRhena",
        "type": "WMS",
        "url": "https://geoportal.georhena.eu/geoserver/ows?service=wms&version=1.3.0&request=GetCapabilities"
      },
      {
        "label": "WMS Kanton Solothurn",
        "type": "WMS",
        "url": "https://geo.so.ch/api/wms"
      },
      {
        "label": "WMTS Kanton Solothurn",
        "type": "WMTS",
        "url": "https://geo.so.ch/api/wmts/1.0.0/WMTSCapabilities.xml"
      }
    ]
  }
}
