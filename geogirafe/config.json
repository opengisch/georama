{
  "general": {
    "locale": "de-CH"
  },
  "languages": {
    "translations": {
      "de": ["de.json", "Mock/de.json"],
      "en": ["en.json", "Mock/en.json"],
      "fr": ["fr.json", "Mock/fr.json"]
    },
    "defaultLanguage": "de"
  },
  "interface": {
    "defaultSelectionComponent": "grid"
  },
  "themes": {
    "url": "http://localhost:8080/clogs/mapbs/themes.json",
    "defaultTheme": "",
    "selectionMode": "add"
  },
  "basemaps": {
    "defaultBasemap": "Grundkarte farbig",
