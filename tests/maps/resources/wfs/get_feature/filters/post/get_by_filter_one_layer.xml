<GetFeature service="WFS" version="2.0.0"
            xmlns="http://www.opengis.net/wfs/2.0"
            xmlns:georama="https://www.opengis.ch/georama"
            xmlns:fes="http://www.opengis.net/fes/2.0"
            xmlns:gml="http://www.opengis.net/gml/3.2">
    <Query typeNames="georama:orientierung.kantons_grenzen">
        <fes:Filter>
                <fes:PropertyIsEqualTo matchCase="false">
                    <fes:ValueReference>kanton_id_bfs</fes:ValueReference>
                    <fes:Literal>2</fes:Literal>
                </fes:PropertyIsEqualTo>
        </fes:Filter>
    </Query>
</GetFeature>
