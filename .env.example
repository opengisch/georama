QSL_LOG_LEVEL=debug
QSL_REPLICAS=1
QSL_REDIS_URL=redis://qsl-redis
QSL_DATA_ROOT=/io/data

GEORAMA_DATA_INTEGRATION_ROOT=/io/data

GEORAMA_DB_PW=test
GEORAMA_DB_USER=postgres
GEORAMA_DB_PORT=5432
GEORAMA_DB_HOST=georama-db
GEORAMA_DB_NAME=postgres

GEORAMA_ALLOWED_HOSTS=localhost

GEORAMA_LOCAL_DATA=<path-to-your-qgis-projects>

# space separated list of authentication methods for georama
# implemented methods at the moment: "DJANGO_CONTRIB_AUTH", "BASIC_HTTP"
GEORAMA_AUTHENTICATION_METHODS="DJANGO_CONTRIB_AUTH BASIC_HTTP"