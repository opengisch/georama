QSL_LOG_LEVEL=debug
QSL_REPLICAS=1
QSL_REDIS_URL=redis://qsl-redis
QSL_DATA_ROOT=/io/data

GEORAMA_QMELEON_DATA_MOUNT=/io/data

GEORAMA_DB_PW=test
GEORAMA_DB_USER=postgres
GEORAMA_DB_PORT=5432
GEORAMA_DB_HOST=georama-db
GEORAMA_DB_NAME=postgres

GEORAMA_LOCAL_DATA=<path-to-your-qgis-projects>

GEORAMA_PORT=8000

WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8442

GEORAMA_HOST=localhost
GEORAMA_ALLOWED_HOSTS="localhost;127.0.0.1;0.0.0.0;georama;nginx"
GEORAMA_CSRF_TRUSTED_ORIGINS="https://$GEORAMA_HOST"

GEORAMA_TLS_CERT="/etc/nginx/certs/${GEORAMA_HOST}.pem"
GEORAMA_TLS_KEY="/etc/nginx/certs/${GEORAMA_HOST}-key.pem"
GEORAMA_TLS_DHPARAMS="/etc/nginx/dhparams/ssl-dhparams.pem"

LETSENCRYPT_EMAIL="test@example.com"
LETSENCRYPT_STAGING=1
LETSENCRYPT_RSA_KEY_SIZE=4096
