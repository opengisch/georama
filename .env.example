#########
# General Compose variables
#########

# choose platform you want to run on if necessary (linux/amd64 is default)
# others have to be checked if available
# PLATFORM=linux/amd64

# chooses the variant of the stack, everything else runs automagically
# with just a docker compose up -d
# prod like (default): leave unset
# dev:
# COMPOSE_FILE=compose.yml:compose.dev.yml
# dev with mounted local qsl sources:
# COMPOSE_FILE=compose.yml:compose.dev.yml:compose.dev_with_qsl.yml

#########
# Django runtime settings
#########
DJANGO_SECRET_KEY=you must put a super secret key here!
DJANGO_CORS_ALLOWED_ORIGINS=https://localhost:9309
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:9309
# without it every request is answered with 400 as long as DEBUG is off (Prod)
DJANGO_ALLOWED_HOSTS=.localhost 127.0.0.1

#########
# Georama runtime settings
#########

GEORAMA_DB_NAME=postgres
GEORAMA_DB_USER=postgres
GEORAMA_DB_PW=test
# driver options of the database connection, e.g. {"pool": True}
GEORAMA_DB_OPTIONS={}
# domain georama runs on, used to derive the organisation (mandatory for Prod)
GEORAMA_ORGANISATION_DOMAIN=localhost

# Prod for the prod like setup, Dev for both dev variants (mandatory)
DJANGO_CONFIGURATION=Prod

#########
# QGIS-Server-Light runtime settings
#########

# loglevel of qsl, might be info, warning, debug
# info is the default, debug for the worker in compose.dev_with_qsl.yml
# QSL_LOG_LEVEL=info

# number of workers, compose.dev_with_qsl.yml always runs 1
# QSL_REPLICAS=4

#########
# Settings for the Georama Stack (Worker AND Exporter AND Georama)
#########

# PG_SERVICE_CONF=./docker/pg_service.conf
# LOCAL_PROJECTS=./tests/resources/projects

#########
# Dev only (compose.dev.yml)
#########

# set this to the postgres port you want to use on your machine to access georama db
# HOST_GEORAMA_DB_PORT=5433

# setting this up in sync with you local host system uid/gid allows
# transparent file permissions inside and outside the container
# UID=1000
# GID=1000
# PYTHON_VERSION=3.12

# switch to start the service inside the container (1)
# or just idle forever (0), this is useful when you want
# to start the service yourself for e.g. debug sessions
# or devcontainer
# GEORAMA_DEV_AUTOSTART=1

#########
# Dev with local qsl sources only (compose.dev_with_qsl.yml)
#########

# absolute path to your local qgis-server-light checkout (mandatory)
# LOCAL_QSL_SOURCES=

# same as GEORAMA_DEV_AUTOSTART but for the qsl worker
# QSL_DEV_AUTOSTART=1
